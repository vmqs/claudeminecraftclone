{
  "name": "minecraft-1-5-html",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A browser recreation of Minecraft 1.5.2 in TypeScript and WebGL2.",
  "scripts": {
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "dev": "npm run fetch-assets && vite",
    "build": "npm run fetch-assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@trystero-p2p/nostr": "^0.25.4",
    "@trystero-p2p/torrent": "^0.25.4",
    "@trystero-p2p/ws-relay": "^0.25.4",
    "fflate": "^0.8.3"
  }
}
